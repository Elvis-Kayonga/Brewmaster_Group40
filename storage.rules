rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Authenticated users can read any file (listings, profiles, verifications)
    match /{allPaths=**} {
      allow read: if request.auth != null;
    }

    // Listing images — only the farmer who owns the listing can upload
    match /listings/{listingId}/{fileName} {
      allow write: if request.auth != null
        && request.resource.size < 10 * 1024 * 1024   // 10 MB max
        && request.resource.contentType.matches('image/.*');
    }

    // Profile photos — user can only upload their own
    match /profiles/{userId}/{fileName} {
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 5 * 1024 * 1024    // 5 MB max
        && request.resource.contentType.matches('image/.*');
    }

    // Verification documents — user can only upload their own documents
    match /verification/{userId}/{fileName} {
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 20 * 1024 * 1024;  // 20 MB max (PDFs/scans)
    }
  }
}
